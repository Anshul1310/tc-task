# ──────────────────────────────────────────────
# Root .gitignore for tc-backend & CampusCare
# ──────────────────────────────────────────────

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.prod

# Uploads & Media Files
src/uploads/*
!src/uploads/.gitkeep

# Python Embedding Sidecar & ChromaDB
python-embeddings/__pycache__/
python-embeddings/*/__pycache__/
python-embeddings/*.py[cod]
python-embeddings/*$py.class
python-embeddings/chroma_db/
python-embeddings/venv/
python-embeddings/.venv/
python-embeddings/env/
python-embeddings/dist/
python-embeddings/build/

# Android App (CampusCare)
CampusCare/.gradle/
CampusCare/build/
CampusCare/app/build/
CampusCare/captures/
CampusCare/.externalNativeBuild/
CampusCare/.cxx/
CampusCare/local.properties
CampusCare/*.iml
CampusCare/app/*.iml

# IDE & Editor Files
.idea/
.vscode/
*.ipr
*.iws
*.swp
*.swo

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
