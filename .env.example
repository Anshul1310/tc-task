# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──────────────────────────────────────────────
# Database (PostgreSQL + pgvector)
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/campuscare?schema=public

# ──────────────────────────────────────────────
# DAuth (register at https://auth.delta.nitt.edu)
# ──────────────────────────────────────────────
DAUTH_CLIENT_ID=your_client_id
DAUTH_CLIENT_SECRET=your_client_secret
DAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# ──────────────────────────────────────────────
# OpenCage Reverse Geocoding API Key
# (Get free key at https://opencagedata.com)
# ──────────────────────────────────────────────
OPENCAGE_API_KEY=your_opencage_api_key

# ──────────────────────────────────────────────
# Python Embedding Server (FastEmbed + ChromaDB)
# ──────────────────────────────────────────────
EMBEDDING_SERVICE_URL=http://localhost:5050

# ──────────────────────────────────────────────
# Session
# ──────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-random-string
